APP_NAME="Health Prospect CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Desenvolvimento / homologação
PUBLIC_REGISTRATION_ENABLED=true
TESTER_ACCESS_ENABLED=true
LOGIN_IDENTITY_RATE_LIMIT=5
LOGIN_IP_RATE_LIMIT=30
LOGIN_RATE_LIMIT_DECAY_SECONDS=60
REGISTER_IDENTITY_RATE_LIMIT=3
REGISTER_IP_RATE_LIMIT=10

# Produção (injete os secrets pelo ambiente/secret manager; nunca os grave neste arquivo):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://crm.seudominio.com
# PUBLIC_REGISTRATION_ENABLED=false
# TESTER_ACCESS_ENABLED=false
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=127.0.0.1,::1
# SECURITY_HSTS_ENABLED=true
# LOG_CHANNEL=stack
# LOG_STACK=daily
# LOG_LEVEL=warning
# LOG_DAILY_DAYS=14

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=health_prospect_crm
DB_USERNAME=health_prospect_crm
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Em produção HTTPS, use SESSION_SECURE_COOKIE=true.

# IPs/CIDRs dos proxies que se conectam diretamente ao Laravel, separados por vírgula.
# O padrão aceita somente loopback, compatível com cloudflared executado localmente.
TRUSTED_PROXIES=127.0.0.1,::1

SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
# Em produção HTTPS, habilite HSTS. Não use preload.
# SECURITY_HSTS_ENABLED=true
# Habilite includeSubDomains somente se todos os subdomínios utilizarem HTTPS.
# As policies abaixo já possuem defaults conservadores e podem ser sobrescritas se necessário.
# SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
# Em APP_ENV=local, o default também permite o servidor Vite em localhost:5173.
# SECURITY_CONTENT_SECURITY_POLICY="default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws: wss:"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
IMPORTS_DISK=imports
IMPORTS_MAX_UPLOAD_KB=10240
IMPORTS_BATCH_SIZE=500
IMPORTS_XLSX_MAX_ROWS=100000
IMPORTS_XLSX_MAX_COLUMNS=250
IMPORTS_XLSX_MAX_ARCHIVE_ENTRIES=10000
IMPORTS_XLSX_MAX_UNCOMPRESSED_BYTES=67108864
IMPORTS_XLSX_MAX_COMPRESSION_RATIO=100
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
